import { Button, CheckBox, ComboBox, ScrollView, Slider } from "std-widgets.slint";

component SettingItem inherits Rectangle {
    in property <string> label: "Configuração";
    in property <string> description: "";
    height: desc_txt.text != "" ? 56px : 42px;
    background: #00000020;
    border-radius: 6px;
    border-width: 1px;
    border-color: #ffffff0a;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                font-size: 13px;
                font-weight: 600;
                color: #f1f5f9;
                overflow: elide;
            }
            desc_txt := Text {
                text: root.description;
                font-size: 11px;
                color: #94a3b8;
                visible: self.text != "";
                overflow: elide;
            }
        }

        @children
    }
}

component TabButton inherits Rectangle {
    in property <string> title: "Tab";
    in property <image> icon_source;
    in property <bool> active: false;
    callback clicked();

    horizontal-stretch: 1;
    height: 38px;
    background: root.active ? #38bdf825 : (touch.has-hover ? #ffffff12 : #ffffff08);
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? #38bdf890 : #ffffff0f;

    HorizontalLayout {
        alignment: center;
        spacing: 7px;
        padding-left: 8px;
        padding-right: 8px;

        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon_source;
                width: 15px;
                height: 15px;
                colorize: root.active ? #38bdf8 : #cbd5e1;
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.title;
                font-size: 12px;
                font-weight: root.active ? 700 : 500;
                color: root.active ? #38bdf8 : #cbd5e1;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

export component SettingsWindow inherits Window {
    title: root.i18n_window_title;
    icon: @image-url("../assets/icon.png");
    width: 540px;
    height: 620px;
    background: #111218f4;
    default-font-family: "Segoe UI Variable Display, Segoe UI, sans-serif";

    // Callbacks
    callback request_save();
    callback request_apply();
    callback request_close();
    callback request_move_module_up(string);
    callback request_move_module_down(string);
    callback culture_changed(string);

    // Estado da Aba Ativa: 0=Geral, 1=Avançado, 2=Estilo, 3=Monitores, 4=Atalhos
    in-out property <int> current_tab: 0;

    // Idioma e Textos Localizados
    in-out property <string> culture: "en-US";
    in-out property <string> i18n_window_title: "ZenithBar - Settings";
    in-out property <string> i18n_header_title: "ZenithBar Settings";
    in-out property <string> i18n_header_desc: "Customize dock, monitored hardware and bar style";
    in-out property <string> i18n_tab_general: "General";
    in-out property <string> i18n_tab_advanced: "Advanced";
    in-out property <string> i18n_tab_style: "Style";
    in-out property <string> i18n_tab_monitors: "Hardware";
    in-out property <string> i18n_tab_hotkeys: "Hotkeys";

    // Tab General
    in-out property <string> i18n_language_label: "Interface Language";
    in-out property <string> i18n_language_desc: "Select the display language for the application";
    in-out property <string> i18n_dock_label: "Screen Placement";
    in-out property <string> i18n_dock_desc: "Monitor edge where the panel docks";
    in-out property <string> i18n_dock_left: "Left";
    in-out property <string> i18n_dock_right: "Right";
    in-out property <string> i18n_monitor_label: "Display Monitor";
    in-out property <string> i18n_monitor_desc: "Choose which screen displays the diagnostic sidebar";
    in-out property <string> i18n_monitor_primary: "Monitor 1 (Primary)";
    in-out property <string> i18n_monitor_2: "Monitor 2";
    in-out property <string> i18n_monitor_3: "Monitor 3";
    in-out property <string> i18n_appbar_label: "Reserve Desktop Space (AppBar)";
    in-out property <string> i18n_appbar_desc: "Pushes maximized windows so they do not overlap the sidebar";
    in-out property <string> i18n_always_top_label: "Always on Top";
    in-out property <string> i18n_always_top_desc: "Keep sidebar visible above normal windows";
    in-out property <string> i18n_startup_label: "Start with Windows";
    in-out property <string> i18n_startup_desc: "Run ZenithBar automatically when computer boots";
    in-out property <string> i18n_initially_hidden_label: "Start Hidden";
    in-out property <string> i18n_initially_hidden_desc: "Starts minimized directly to system tray";

    // Tab Advanced
    in-out property <string> i18n_polling_label: "Sensor Refresh Rate";
    in-out property <string> i18n_polling_desc: "Telemetry sampling interval";
    in-out property <string> i18n_tray_icon_label: "System Tray Icon";
    in-out property <string> i18n_tray_icon_desc: "Shows icon next to Windows clock with quick menu";
    in-out property <string> i18n_click_through_label: "Transparent Clicks (Click-Through)";
    in-out property <string> i18n_click_through_desc: "Allows clicking through the bar to items behind it";
    in-out property <string> i18n_collapse_menu_label: "Collapse Header Action Buttons";
    in-out property <string> i18n_collapse_menu_desc: "Hides settings and dock buttons for minimal look";
    in-out property <string> i18n_auto_update_label: "Automatic Update Check";
    in-out property <string> i18n_auto_update_desc: "Periodically checks for new ZenithBar versions";

    // Tab Style
    in-out property <string> i18n_sidebar_width_label: "Sidebar Width";
    in-out property <string> i18n_sidebar_width_desc: "Custom width from 180px to 360px reserved on screen";
    in-out property <string> i18n_bg_opacity_label: "Acrylic Background Opacity";
    in-out property <string> i18n_bg_opacity_desc: "Intensity of Fluent translucent glass effect";
    in-out property <string> i18n_text_align_label: "Text Alignment";
    in-out property <string> i18n_text_align_desc: "Orientation of texts and metrics in cards";
    in-out property <string> i18n_align_left: "Left";
    in-out property <string> i18n_align_right: "Right";
    in-out property <string> i18n_show_hostname_label: "Show Computer Name (Hostname)";
    in-out property <string> i18n_show_hostname_desc: "Shows machine name in top card";
    in-out property <string> i18n_show_clock_label: "Show Clock and Date";
    in-out property <string> i18n_show_clock_desc: "Shows time and date at top of sidebar";
    in-out property <string> i18n_clock_24hr_label: "24-Hour Time Format";
    in-out property <string> i18n_clock_24hr_desc: "Uncheck to show 12h format (AM/PM)";
    in-out property <string> i18n_alert_blink_label: "Highlighted Visual Alerts";
    in-out property <string> i18n_alert_blink_desc: "Highlights in red when temp > 80°C and load > 85%";

    // Tab Hardware
    in-out property <string> i18n_enable_cpu_label: "CPU Module";
    in-out property <string> i18n_enable_cpu_desc: "Load %, clock, temperature and history";
    in-out property <string> i18n_show_cores_label: "  └ Per-Core Micro-Bars Grid";
    in-out property <string> i18n_show_cores_desc: "Displays micro-bar for each physical/logical core";
    in-out property <string> i18n_enable_ram_label: "RAM Module";
    in-out property <string> i18n_enable_ram_desc: "Used GB, system total and percent occupied";
    in-out property <string> i18n_enable_gpu_label: "GPU Module";
    in-out property <string> i18n_enable_gpu_desc: "3D load, GPU temperature, VRAM and fan RPM";
    in-out property <string> i18n_enable_disks_label: "Storage Module (Drives)";
    in-out property <string> i18n_enable_disks_desc: "Disk space and read/write speeds in real time";
    in-out property <string> i18n_show_all_disks_label: "  └ List All Connected Drives";
    in-out property <string> i18n_show_all_disks_desc: "Show all logical volumes (C:, D:, ...) or primary only";
    in-out property <string> i18n_enable_network_label: "Network Module (Ethernet / Wi-Fi)";
    in-out property <string> i18n_enable_network_desc: "Download/Upload speeds, Local IP and WAN IP";
    in-out property <string> i18n_show_sparklines_label: "Real-Time History Graphs";
    in-out property <string> i18n_show_sparklines_desc: "Show continuous Sparkline trend curves on modules";

    // Tab Hotkeys
    in-out property <string> i18n_hotkey_toggle_label: "Show / Hide Sidebar";
    in-out property <string> i18n_hotkey_toggle_desc: "Global hotkey to toggle panel visibility";
    in-out property <string> i18n_hotkey_edge_label: "Cycle Screen Edge";
    in-out property <string> i18n_hotkey_edge_desc: "Instantly moves sidebar between Left and Right";
    in-out property <string> i18n_hotkey_screen_label: "Cycle Active Monitor";
    in-out property <string> i18n_hotkey_screen_desc: "Moves sidebar to next connected display";
    in-out property <string> i18n_hotkey_reserve_label: "Toggle Space Reservation (AppBar)";
    in-out property <string> i18n_hotkey_reserve_desc: "Toggles space reservation for maximized windows";

    // Buttons
    in-out property <string> i18n_btn_cancel: "Cancel";
    in-out property <string> i18n_btn_apply: "Apply";
    in-out property <string> i18n_btn_save: "Save Changes";

    // Aba Geral
    in-out property <bool> dock_right: true;
    in-out property <int> monitor_idx: 0;
    in-out property <int> monitor_count: 1;
    in-out property <bool> use_app_bar: true;
    in-out property <bool> always_top: true;
    in-out property <bool> run_at_startup: false;
    in-out property <bool> initially_hidden: false;

    // Aba Avançado
    in-out property <int> polling_interval: 1000;
    in-out property <float> ui_scale: 1.0;
    in-out property <bool> show_tray_icon: true;
    in-out property <bool> click_through: false;
    in-out property <bool> collapse_menu_bar: false;
    in-out property <bool> auto_update: true;

    // Aba Estilo
    in-out property <int> sidebar_width: 300;
    in-out property <float> bg_opacity: 0.95;
    in-out property <bool> text_align_right: false;
    in-out property <bool> show_machine_name: true;
    in-out property <bool> show_clock: true;
    in-out property <bool> clock_24hr: true;
    in-out property <bool> alert_blink: true;

    // Aba Monitores
    in-out property <bool> enable_cpu: true;
    in-out property <bool> show_cpu_cores: true;
    in-out property <bool> enable_ram: true;
    in-out property <bool> enable_gpu: true;
    in-out property <bool> enable_disks: true;
    in-out property <bool> show_all_disks: false;
    in-out property <bool> enable_network: true;
    in-out property <bool> show_sparklines: true;

    // Aba Atalhos
    in-out property <string> hotkey_toggle: "Ctrl+Shift+S";
    in-out property <string> hotkey_cycle_edge: "Ctrl+Shift+E";
    in-out property <string> hotkey_cycle_screen: "Ctrl+Shift+M";
    in-out property <string> hotkey_reserve_space: "Ctrl+Shift+R";

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Window Header
        HorizontalLayout {
            alignment: space-between;
            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Image {
                    source: @image-url("../assets/icon.png");
                    width: 36px;
                    height: 36px;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: root.i18n_header_title;
                        font-size: 18px;
                        font-weight: 800;
                        color: #ffffff;
                    }
                    Text {
                        text: root.i18n_header_desc;
                        font-size: 11px;
                        color: #64748b;
                    }
                }
            }
        }

        // Navigation Tabs (1:1 com SidebarDiagnostics)
        HorizontalLayout {
            spacing: 6px;

            TabButton {
                title: root.i18n_tab_general;
                icon_source: @image-url("../assets/icons/settings.svg");
                active: root.current_tab == 0;
                clicked => { root.current_tab = 0; }
            }
            TabButton {
                title: root.i18n_tab_advanced;
                icon_source: @image-url("../assets/icons/cpu.svg");
                active: root.current_tab == 1;
                clicked => { root.current_tab = 1; }
            }
            TabButton {
                title: root.i18n_tab_style;
                icon_source: @image-url("../assets/icons/dock.svg");
                active: root.current_tab == 2;
                clicked => { root.current_tab = 2; }
            }
            TabButton {
                title: root.i18n_tab_monitors;
                icon_source: @image-url("../assets/icons/gpu.svg");
                active: root.current_tab == 3;
                clicked => { root.current_tab = 3; }
            }
            TabButton {
                title: root.i18n_tab_hotkeys;
                icon_source: @image-url("../assets/icons/network.svg");
                active: root.current_tab == 4;
                clicked => { root.current_tab = 4; }
            }
        }

        Rectangle {
            height: 1px;
            background: #ffffff10;
        }

        // Scrollable Tab View
        ScrollView {
            vertical-stretch: 1;
            content-width: self.width;

            VerticalLayout {
                spacing: 10px;
                padding-right: 8px;

                // ================= TAB 0: GERAL =================
                if root.current_tab == 0 : VerticalLayout {
                    spacing: 8px;

                    SettingItem {
                        label: root.i18n_language_label;
                        description: root.i18n_language_desc;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            Button {
                                text: (root.culture == "en-US" || root.culture == "en-us" || root.culture == "en") ? "✔ English" : "English";
                                primary: (root.culture == "en-US" || root.culture == "en-us" || root.culture == "en");
                                clicked => {
                                    root.culture = "en-US";
                                    root.culture_changed("en-US");
                                }
                            }
                            Button {
                                text: (root.culture == "pt-BR" || root.culture == "pt-br" || root.culture == "pt") ? "✔ Português" : "Português";
                                primary: (root.culture == "pt-BR" || root.culture == "pt-br" || root.culture == "pt");
                                clicked => {
                                    root.culture = "pt-BR";
                                    root.culture_changed("pt-BR");
                                }
                            }
                        }
                    }

                    SettingItem {
                        label: root.i18n_dock_label;
                        description: root.i18n_dock_desc;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            Button {
                                text: !root.dock_right ? "✔ " + root.i18n_dock_left : root.i18n_dock_left;
                                primary: !root.dock_right;
                                clicked => { root.dock_right = false; }
                            }
                            Button {
                                text: root.dock_right ? "✔ " + root.i18n_dock_right : root.i18n_dock_right;
                                primary: root.dock_right;
                                clicked => { root.dock_right = true; }
                            }
                        }
                    }

                    SettingItem {
                        label: root.i18n_monitor_label;
                        description: root.i18n_monitor_desc;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            Button {
                                text: root.monitor_idx == 0 ? "✔ " + root.i18n_monitor_primary : root.i18n_monitor_primary;
                                primary: root.monitor_idx == 0;
                                clicked => { root.monitor_idx = 0; }
                            }
                            if root.monitor_count > 1 : Button {
                                text: root.monitor_idx == 1 ? "✔ " + root.i18n_monitor_2 : root.i18n_monitor_2;
                                primary: root.monitor_idx == 1;
                                clicked => { root.monitor_idx = 1; }
                            }
                            if root.monitor_count > 2 : Button {
                                text: root.monitor_idx == 2 ? "✔ " + root.i18n_monitor_3 : root.i18n_monitor_3;
                                primary: root.monitor_idx == 2;
                                clicked => { root.monitor_idx = 2; }
                            }
                        }
                    }

                    SettingItem {
                        label: root.i18n_appbar_label;
                        description: root.i18n_appbar_desc;
                        CheckBox {
                            checked: root.use_app_bar;
                            toggled => { root.use_app_bar = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_always_top_label;
                        description: root.i18n_always_top_desc;
                        CheckBox {
                            checked: root.always_top;
                            toggled => { root.always_top = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_startup_label;
                        description: root.i18n_startup_desc;
                        CheckBox {
                            checked: root.run_at_startup;
                            toggled => { root.run_at_startup = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_initially_hidden_label;
                        description: root.i18n_initially_hidden_desc;
                        CheckBox {
                            checked: root.initially_hidden;
                            toggled => { root.initially_hidden = self.checked; }
                        }
                    }
                }

                // ================= TAB 1: AVANÇADO =================
                if root.current_tab == 1 : VerticalLayout {
                    spacing: 8px;

                    SettingItem {
                        label: root.i18n_polling_label;
                        description: root.i18n_polling_desc;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;
                            Button {
                                text: root.polling_interval == 250 ? "✔ 250ms" : "250ms";
                                primary: root.polling_interval == 250;
                                clicked => { root.polling_interval = 250; }
                            }
                            Button {
                                text: root.polling_interval == 500 ? "✔ 500ms" : "500ms";
                                primary: root.polling_interval == 500;
                                clicked => { root.polling_interval = 500; }
                            }
                            Button {
                                text: root.polling_interval == 1000 ? "✔ 1s" : "1s";
                                primary: root.polling_interval == 1000;
                                clicked => { root.polling_interval = 1000; }
                            }
                            Button {
                                text: root.polling_interval == 2000 ? "✔ 2s" : "2s";
                                primary: root.polling_interval == 2000;
                                clicked => { root.polling_interval = 2000; }
                            }
                        }
                    }

                    SettingItem {
                        label: root.i18n_tray_icon_label;
                        description: root.i18n_tray_icon_desc;
                        CheckBox {
                            checked: root.show_tray_icon;
                            toggled => { root.show_tray_icon = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_click_through_label;
                        description: root.i18n_click_through_desc;
                        CheckBox {
                            checked: root.click_through;
                            toggled => { root.click_through = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_collapse_menu_label;
                        description: root.i18n_collapse_menu_desc;
                        CheckBox {
                            checked: root.collapse_menu_bar;
                            toggled => { root.collapse_menu_bar = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_auto_update_label;
                        description: root.i18n_auto_update_desc;
                        CheckBox {
                            checked: root.auto_update;
                            toggled => { root.auto_update = self.checked; }
                        }
                    }
                }

                // ================= TAB 2: ESTILO =================
                if root.current_tab == 2 : VerticalLayout {
                    spacing: 8px;

                    SettingItem {
                        label: root.i18n_sidebar_width_label;
                        description: root.i18n_sidebar_width_desc;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            Text { text: "180px"; color: #94a3b8; font-size: 11px; vertical-alignment: center; }
                            Slider {
                                width: 170px;
                                minimum: 180;
                                maximum: 360;
                                value: root.sidebar_width;
                                changed(val) => { root.sidebar_width = round(val); }
                            }
                            Text { text: "360px"; color: #94a3b8; font-size: 11px; vertical-alignment: center; }
                            Rectangle {
                                width: 58px;
                                height: 26px;
                                background: #38bdf820;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #38bdf860;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.sidebar_width + "px";
                                        color: #38bdf8;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    SettingItem {
                        label: root.i18n_bg_opacity_label;
                        description: root.i18n_bg_opacity_desc;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;
                            Button {
                                text: root.bg_opacity < 0.80 ? "✔ 75%" : "75%";
                                primary: root.bg_opacity < 0.80;
                                clicked => { root.bg_opacity = 0.75; }
                            }
                            Button {
                                text: root.bg_opacity >= 0.80 && root.bg_opacity < 0.95 ? "✔ 88%" : "88%";
                                primary: root.bg_opacity >= 0.80 && root.bg_opacity < 0.95;
                                clicked => { root.bg_opacity = 0.88; }
                            }
                            Button {
                                text: root.bg_opacity >= 0.95 ? "✔ 96%" : "96%";
                                primary: root.bg_opacity >= 0.95;
                                clicked => { root.bg_opacity = 0.96; }
                            }
                        }
                    }

                    SettingItem {
                        label: root.i18n_text_align_label;
                        description: root.i18n_text_align_desc;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            Button {
                                text: !root.text_align_right ? "✔ " + root.i18n_align_left : root.i18n_align_left;
                                primary: !root.text_align_right;
                                clicked => { root.text_align_right = false; }
                            }
                            Button {
                                text: root.text_align_right ? "✔ " + root.i18n_align_right : root.i18n_align_right;
                                primary: root.text_align_right;
                                clicked => { root.text_align_right = true; }
                            }
                        }
                    }

                    SettingItem {
                        label: root.i18n_show_hostname_label;
                        description: root.i18n_show_hostname_desc;
                        CheckBox {
                            checked: root.show_machine_name;
                            toggled => { root.show_machine_name = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_show_clock_label;
                        description: root.i18n_show_clock_desc;
                        CheckBox {
                            checked: root.show_clock;
                            toggled => { root.show_clock = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_clock_24hr_label;
                        description: root.i18n_clock_24hr_desc;
                        CheckBox {
                            checked: root.clock_24hr;
                            toggled => { root.clock_24hr = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_alert_blink_label;
                        description: root.i18n_alert_blink_desc;
                        CheckBox {
                            checked: root.alert_blink;
                            toggled => { root.alert_blink = self.checked; }
                        }
                    }
                }

                // ================= TAB 3: MONITORES & HARDWARE =================
                if root.current_tab == 3 : VerticalLayout {
                    spacing: 8px;

                    SettingItem {
                        label: root.i18n_enable_cpu_label;
                        description: root.i18n_enable_cpu_desc;
                        CheckBox {
                            checked: root.enable_cpu;
                            toggled => { root.enable_cpu = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_show_cores_label;
                        description: root.i18n_show_cores_desc;
                        CheckBox {
                            checked: root.show_cpu_cores;
                            toggled => { root.show_cpu_cores = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_enable_ram_label;
                        description: root.i18n_enable_ram_desc;
                        CheckBox {
                            checked: root.enable_ram;
                            toggled => { root.enable_ram = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_enable_gpu_label;
                        description: root.i18n_enable_gpu_desc;
                        CheckBox {
                            checked: root.enable_gpu;
                            toggled => { root.enable_gpu = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_enable_disks_label;
                        description: root.i18n_enable_disks_desc;
                        CheckBox {
                            checked: root.enable_disks;
                            toggled => { root.enable_disks = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_show_all_disks_label;
                        description: root.i18n_show_all_disks_desc;
                        CheckBox {
                            checked: root.show_all_disks;
                            toggled => { root.show_all_disks = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_enable_network_label;
                        description: root.i18n_enable_network_desc;
                        CheckBox {
                            checked: root.enable_network;
                            toggled => { root.enable_network = self.checked; }
                        }
                    }

                    SettingItem {
                        label: root.i18n_show_sparklines_label;
                        description: root.i18n_show_sparklines_desc;
                        CheckBox {
                            checked: root.show_sparklines;
                            toggled => { root.show_sparklines = self.checked; }
                        }
                    }
                }

                // ================= TAB 4: ATALHOS DE TECLADO =================
                if root.current_tab == 4 : VerticalLayout {
                    spacing: 8px;

                    SettingItem {
                        label: root.i18n_hotkey_toggle_label;
                        description: root.i18n_hotkey_toggle_desc;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            Rectangle {
                                background: #ffffff10;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #38bdf840;
                                height: 30px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: root.hotkey_toggle;
                                        color: #38bdf8;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    SettingItem {
                        label: root.i18n_hotkey_edge_label;
                        description: root.i18n_hotkey_edge_desc;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            Rectangle {
                                background: #ffffff10;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #a855f740;
                                height: 30px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: root.hotkey_cycle_edge;
                                        color: #a855f7;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    SettingItem {
                        label: root.i18n_hotkey_screen_label;
                        description: root.i18n_hotkey_screen_desc;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            Rectangle {
                                background: #ffffff10;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #10b98140;
                                height: 30px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: root.hotkey_cycle_screen;
                                        color: #10b981;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    SettingItem {
                        label: root.i18n_hotkey_reserve_label;
                        description: root.i18n_hotkey_reserve_desc;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            Rectangle {
                                background: #ffffff10;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #f59e0b40;
                                height: 30px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: root.hotkey_reserve_space;
                                        color: #f59e0b;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: #ffffff15;
        }

        // Bottom Action Bar (1:1 com SidebarDiagnostics: Cancelar, Aplicar, Salvar)
        HorizontalLayout {
            spacing: 10px;
            alignment: end;

            Button {
                text: root.i18n_btn_cancel;
                clicked => { root.request_close(); }
            }

            Button {
                text: root.i18n_btn_apply;
                clicked => { root.request_apply(); }
            }

            Button {
                text: root.i18n_btn_save;
                primary: true;
                clicked => { root.request_save(); }
            }
        }
    }
}
