import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { SettingsWindow } from "settingswindow.slint";
export { SettingsWindow }

export struct DiskInfo {
    name: string,
    mount: string,
    used_gb: string,
    total_gb: string,
    percent: float,
    read_speed: string,
    write_speed: string,
}

component Sparkline inherits Rectangle {
    in property <[float]> values: [0.1, 0.2, 0.15, 0.4, 0.6, 0.35, 0.5, 0.7, 0.65, 0.8];
    in property <color> line_color: #38bdf8;
    height: 36px;
    background: #00000030;
    border-radius: 6px;
    clip: true;

    HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        for val in root.values : Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            VerticalLayout {
                alignment: end;
                Rectangle {
                    height: max(3px, val * (root.height - 8px));
                    background: root.line_color;
                    border-radius: 1px;
                }
            }
        }
    }
}

component ProgressBar inherits Rectangle {
    in property <float> progress: 0.5; // 0.0 to 1.0
    in property <color> bar_color: #38bdf8;
    height: 6px;
    background: #ffffff15;
    border-radius: 3px;
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width * max(0.0, min(1.0, root.progress));
        height: parent.height;
        background: root.bar_color;
        border-radius: 3px;
    }
}

component EditableLabel inherits Rectangle {
    in property <string> text: "";
    in property <length> font_size: 10px;
    in property <int> font_weight: 400;
    in property <color> text_color: #94a3b8;
    in property <color> accent_color: #38bdf8;
    callback committed(string);

    private property <bool> editing: false;
    private property <string> draft_text: "";
    vertical-stretch: 0;
    border-radius: 4px;
    background: root.editing ? #0f172a : (ta.has-hover ? #ffffff0a : transparent);
    border-width: root.editing ? 1px : 0px;
    border-color: root.editing ? root.accent_color : transparent;

    ta := TouchArea {
        enabled: !root.editing;
        mouse-cursor: root.editing ? default : pointer;
        clicked => {
            root.draft_text = root.text;
            root.editing = true;
        }
    }

    if !root.editing : HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        padding-top: 1px;
        padding-bottom: 1px;
        spacing: 4px;

        Text {
            text: root.text;
            font-size: root.font_size;
            font-weight: root.font_weight;
            color: ta.has-hover ? #f1f5f9 : root.text_color;
            wrap: word-wrap;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        if ta.has-hover : Text {
            text: "✎";
            font-size: 9px;
            color: root.accent_color;
            vertical-alignment: center;
        }
    }

    if root.editing : HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 4px;

        edit_input := TextInput {
            text <=> root.draft_text;
            font-size: root.font_size;
            font-weight: root.font_weight;
            color: #f8fafc;
            single-line: true;
            horizontal-stretch: 1;
            vertical-alignment: center;
            init => {
                self.focus();
            }
            accepted => {
                root.editing = false;
                root.committed(root.draft_text);
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.editing = false;
                    return accept;
                }
                return reject;
            }
        }

        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 3px;
            background: ok_ta.has-hover ? #10b98140 : #ffffff12;
            Text {
                text: "✓";
                font-size: 9px;
                color: #34d399;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ok_ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.editing = false;
                    root.committed(root.draft_text);
                }
            }
        }

        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 3px;
            background: cancel_ta.has-hover ? #ef444440 : #ffffff12;
            Text {
                text: "✕";
                font-size: 9px;
                color: #f87171;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            cancel_ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.editing = false;
                }
            }
        }
    }
}

component MetricSection inherits Rectangle {
    in property <string> title: "SECTION";
    in property <image> icon_source;
    in property <color> accent_color: #38bdf8;
    in property <bool> alert_active: false;
    in property <string> badge: "";
    callback toggle_collapse();

    vertical-stretch: 0;
    background: root.alert_active ? #2a1015ee : #181920ee;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.alert_active ? #ef444480 : #ffffff12;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        alignment: start;

        // Header
        HorizontalLayout {
            spacing: 6px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 6px;
                horizontal-stretch: 1;
                Image {
                    source: root.icon_source;
                    width: 14px;
                    height: 14px;
                    colorize: root.alert_active ? #ef4444 : root.accent_color;
                    vertical-alignment: center;
                }
                Text {
                    text: root.title;
                    font-size: 11px;
                    font-weight: 700;
                    color: root.alert_active ? #fca5a5 : #f1f5f9;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }

            if root.badge != "": Text {
                text: root.badge;
                font-size: 10px;
                color: root.alert_active ? #ef4444 : root.accent_color;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Slot for children
        @children
    }
}

export component AppWindow inherits Window {
    title: "ZenithBar";
    icon: @image-url("../assets/icon.png");
    width: root.sidebar_width_px * 1px;
    height: root.sidebar_height_px * 1px;
    no-frame: true;
    background: Colors.rgb(15, 16, 21).with-alpha(root.bg_opacity_val);
    default-font-family: "Segoe UI Variable Display, Segoe UI, sans-serif";

    // Callbacks to Rust
    callback request_toggle_dock();
    callback request_toggle_mode();
    callback request_toggle_topmost();
    callback request_open_settings();
    callback request_next_disk();
    callback request_quit();
    callback request_set_custom_hostname(string);
    callback request_set_custom_cpu_name(string);
    callback request_set_custom_gpu_name(string);
    callback request_set_custom_net_name(string);

    // Dynamic sizing & opacity
    in-out property <float> sidebar_width_px: 300;
    in-out property <float> sidebar_height_px: 1080;
    in-out property <float> bg_opacity_val: 0.96;

    // System Header
    in-out property <string> hostname: "Meu PC";
    in-out property <string> time_str: "12:00:00";
    in-out property <string> date_str: "Sábado, 14 Nov";
    in-out property <string> uptime_str: "0h 0m";
    in-out property <string> mode_badge: "USER MODE";
    in-out property <bool> is_appbar: true;
    in-out property <bool> is_docked_right: true;

    // Localized Strings
    in-out property <string> i18n_cpu_title: "PROCESSOR (CPU)";
    in-out property <string> i18n_ram_title: "MEMORY (RAM)";
    in-out property <string> i18n_gpu_title: "GRAPHICS (GPU)";
    in-out property <string> i18n_disks_title: "STORAGE";
    in-out property <string> i18n_network_title: "NETWORK";
    in-out property <string> i18n_clock: "Clock";
    in-out property <string> i18n_temp: "Temp";
    in-out property <string> i18n_usage_per_core: "Per-Core Usage:";
    in-out property <string> i18n_usage: "uso";
    in-out property <string> i18n_fan: "Fan";
    in-out property <string> i18n_local_ip: "Local";
    in-out property <string> i18n_wan_ip: "WAN";
    in-out property <string> i18n_hotkey_hint: "ZenithBar • Ctrl+Shift+S";

    // Telemetria modular e preferências visuais
    in-out property <bool> enable_cpu: true;
    in-out property <bool> show_cpu_cores: true;
    in-out property <bool> enable_ram: true;
    in-out property <bool> enable_gpu: true;
    in-out property <bool> enable_disks: true;
    in-out property <bool> enable_network: true;
    in-out property <bool> show_sparklines: true;
    in-out property <bool> show_machine_name: true;
    in-out property <bool> show_clock: true;
    in-out property <bool> collapse_menu_bar: false;

    // CPU
    in-out property <string> cpu_name: "Intel / AMD Processor";
    in-out property <float> cpu_usage: 0.15;
    in-out property <string> cpu_usage_str: "15%";
    in-out property <string> cpu_clock_str: "4.2 GHz";
    in-out property <string> cpu_temp_str: "45°C";
    in-out property <float> cpu_temp_val: 45.0;
    in-out property <[float]> cpu_history: [0.1, 0.12, 0.15, 0.14, 0.18, 0.22, 0.19, 0.16, 0.15, 0.15];
    in-out property <[float]> cpu_core_loads: [0.1, 0.2, 0.15, 0.25, 0.1, 0.3, 0.05, 0.18];

    // RAM
    in-out property <string> ram_usage_str: "8.2 / 32.0 GB";
    in-out property <float> ram_percent: 0.25;
    in-out property <string> ram_percent_str: "25%";
    in-out property <string> ram_available_str: "23.8 GB Disp.";
    in-out property <[float]> ram_history: [0.25, 0.25, 0.25, 0.26, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25];

    // GPU
    in-out property <bool> gpu_detected: true;
    in-out property <string> gpu_name: "GPU Dedicada";
    in-out property <float> gpu_usage: 0.20;
    in-out property <string> gpu_usage_str: "20%";
    in-out property <string> gpu_clock_str: "-- GHz";
    in-out property <string> gpu_temp_str: "52°C";
    in-out property <float> gpu_temp_val: 52.0;
    in-out property <string> gpu_vram_str: "3.5 / 12.0 GB";
    in-out property <string> gpu_vram_pct_str: "29%";
    in-out property <string> gpu_fan_str: "1250 RPM";
    in-out property <string> gpu_fan_pct_str: "--%";
    in-out property <[float]> gpu_history: [0.05, 0.08, 0.12, 0.25, 0.32, 0.20, 0.15, 0.18, 0.22, 0.20];

    // Disks
    in-out property <bool> show_all_disks: false;
    in-out property <[DiskInfo]> disks_list: [];
    in-out property <string> disk_primary_name: "C: (SSD)";
    in-out property <string> disk_primary_usage: "450 / 950 GB (47%)";
    in-out property <float> disk_primary_percent: 0.47;
    in-out property <string> disk_read_str: "0.0 MB/s";
    in-out property <string> disk_write_str: "1.2 MB/s";

    // Network
    in-out property <string> net_adapter_name: "Ethernet / Wi-Fi";
    in-out property <string> net_download_str: "12.4 Mbps";
    in-out property <string> net_upload_str: "2.1 Mbps";
    in-out property <string> net_ip_str: "192.168.1.100";
    in-out property <string> net_ext_ip_str: "--";
    in-out property <[float]> net_history: [0.1, 0.15, 0.3, 0.8, 0.5, 0.2, 0.1, 0.4, 0.6, 0.25];

    VerticalLayout {
        padding: 6px;
        spacing: 6px;

        // Top System Bar
        Rectangle {
            background: #14151edd;
            border-radius: 8px;
            border-width: 1px;
            border-color: #ffffff10;
            min-height: 60px;

            HorizontalLayout {
                padding: 8px;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.time_str;
                            font-size: root.sidebar_width_px < 220 ? 15px : 18px;
                            font-weight: 800;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                        if root.show_machine_name : EditableLabel {
                            text: root.hostname;
                            font_size: root.sidebar_width_px < 220 ? 9px : 10px;
                            font_weight: 600;
                            text_color: #38bdf8;
                            accent_color: #38bdf8;
                            horizontal-stretch: 1;
                            committed(val) => { root.request_set_custom_hostname(val); }
                        }
                    }

                    if root.show_clock : HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.date_str;
                            font-size: root.sidebar_width_px < 220 ? 8.5px : 9px;
                            color: #94a3b8;
                            overflow: elide;
                        }
                        Text {
                            text: "• " + root.uptime_str;
                            font-size: root.sidebar_width_px < 220 ? 8.5px : 9px;
                            color: #64748b;
                            overflow: elide;
                        }
                    }
                }

                if !root.collapse_menu_bar : HorizontalLayout {
                    alignment: center;
                    spacing: 4px;

                    // Settings gear button
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        background: #ffffff10;
                        border-radius: 4px;
                        Image {
                            source: @image-url("../assets/icons/settings.svg");
                            width: 12px;
                            height: 12px;
                            colorize: #cbd5e1;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.request_open_settings(); }
                        }
                    }

                    // Dock side switch button
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        background: touch_dock.has-hover ? #ffffff25 : #ffffff10;
                        border-radius: 4px;
                        animate background { duration: 120ms; }
                        Image {
                            source: @image-url("../assets/icons/dock.svg");
                            width: 12px;
                            height: 12px;
                            colorize: touch_dock.has-hover ? #ffffff : #cbd5e1;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            animate colorize { duration: 120ms; }
                        }
                        touch_dock := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.request_toggle_dock(); }
                        }
                    }

                    // Hide to tray button
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        background: touch_hdr_hide.has-hover ? #ef444430 : #ffffff10;
                        border-radius: 4px;
                        animate background { duration: 120ms; }
                        Image {
                            source: @image-url("../assets/icons/close.svg");
                            width: 10px;
                            height: 10px;
                            colorize: touch_hdr_hide.has-hover ? #ef4444 : #cbd5e1;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            animate colorize { duration: 120ms; }
                        }
                        touch_hdr_hide := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.request_quit(); }
                        }
                    }
                }
            }
        }

        // Main Scrollable Area for Metrics
        ScrollView {
            vertical-stretch: 1;
            content-width: self.width;

            VerticalLayout {
                spacing: 6px;
                alignment: start;

                // CPU Section with Per-Core Grid & Threshold Alert
                if root.enable_cpu : MetricSection {
                    title: root.i18n_cpu_title;
                    icon_source: @image-url("../assets/icons/cpu.svg");
                    accent_color: #38bdf8;
                    alert_active: root.cpu_usage > 0.85 || root.cpu_temp_val > 80.0;

                    EditableLabel {
                        text: root.cpu_name;
                        font_size: 10px;
                        text_color: #94a3b8;
                        accent_color: #38bdf8;
                        committed(val) => { root.request_set_custom_cpu_name(val); }
                    }

                    ProgressBar {
                        progress: root.cpu_usage;
                        bar_color: root.cpu_usage > 0.85 ? #ef4444 : #38bdf8;
                    }

                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "CPU:";
                                font-size: 10px;
                                font-weight: 700;
                                color: #cbd5e1;
                            }
                            Text {
                                text: root.cpu_temp_str;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.cpu_temp_val > 80.0 ? #ef4444 : #f1f5f9;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            Text {
                                text: root.cpu_clock_str;
                                font-size: 9.5px;
                                color: #cbd5e1;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            Text {
                                text: root.i18n_usage + ": " + root.cpu_usage_str;
                                font-size: 9.5px;
                                color: #cbd5e1;
                            }
                        }
                    }

                    // Per-Core Load Micro-Bars Grid (fixed height)
                    if (root.show_cpu_cores && root.cpu_core_loads.length > 0) : VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: root.i18n_usage_per_core;
                            font-size: 9px;
                            color: #64748b;
                        }
                        Rectangle {
                            height: 24px;
                            background: #00000020;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;
                                for core_load in root.cpu_core_loads : Rectangle {
                                    horizontal-stretch: 1;
                                    vertical-stretch: 1;
                                    background: #ffffff0a;
                                    border-radius: 2px;
                                    clip: true;
                                    VerticalLayout {
                                        alignment: end;
                                        Rectangle {
                                            height: max(2px, core_load * 20px);
                                            background: core_load > 0.85 ? #ef4444 : (core_load > 0.5 ? #f59e0b : #38bdf8);
                                            border-radius: 1px;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.show_sparklines : Sparkline {
                        values: root.cpu_history;
                        line_color: root.cpu_usage > 0.85 ? #ef4444 : #38bdf8;
                    }
                }

                // RAM Section with Threshold Alert
                if root.enable_ram : MetricSection {
                    title: root.i18n_ram_title;
                    icon_source: @image-url("../assets/icons/ram.svg");
                    accent_color: #a855f7;
                    alert_active: root.ram_percent > 0.90;
                    badge: root.ram_percent_str;

                    ProgressBar {
                        progress: root.ram_percent;
                        bar_color: root.ram_percent > 0.90 ? #ef4444 : #a855f7;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: root.ram_usage_str;
                            font-size: 9.5px;
                            color: #cbd5e1;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if root.sidebar_width_px >= 220 : Text {
                            text: root.ram_available_str;
                            font-size: 9.5px;
                            color: #94a3b8;
                            overflow: elide;
                        }
                    }

                    if root.show_sparklines : Sparkline {
                        values: root.ram_history;
                        line_color: root.ram_percent > 0.90 ? #ef4444 : #a855f7;
                    }
                }

                // GPU Section with Threshold Alert
                if (root.gpu_detected && root.enable_gpu) : MetricSection {
                    title: root.i18n_gpu_title;
                    icon_source: @image-url("../assets/icons/gpu.svg");
                    accent_color: #10b981;
                    alert_active: root.gpu_usage > 0.85 || root.gpu_temp_val > 80.0;

                    EditableLabel {
                        text: root.gpu_name;
                        font_size: 10px;
                        text_color: #94a3b8;
                        accent_color: #10b981;
                        committed(val) => { root.request_set_custom_gpu_name(val); }
                    }

                    ProgressBar {
                        progress: root.gpu_usage;
                        bar_color: root.gpu_usage > 0.85 ? #ef4444 : #10b981;
                    }

                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "GPU:";
                                font-size: 10px;
                                font-weight: 700;
                                color: #cbd5e1;
                            }
                            Text {
                                text: root.gpu_temp_str;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.gpu_temp_val > 80.0 ? #ef4444 : #f1f5f9;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            Text {
                                text: root.gpu_clock_str;
                                font-size: 9.5px;
                                color: #cbd5e1;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            Text {
                                text: root.i18n_usage + ": " + root.gpu_usage_str;
                                font-size: 9.5px;
                                color: #cbd5e1;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            Text {
                                text: "VRAM: " + root.gpu_vram_pct_str;
                                font-size: 9.5px;
                                color: #cbd5e1;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            Text {
                                text: root.i18n_fan + ": " + root.gpu_fan_pct_str;
                                font-size: 9.5px;
                                color: #94a3b8;
                            }
                        }
                    }

                    if root.show_sparklines : Sparkline {
                        values: root.gpu_history;
                        line_color: root.gpu_usage > 0.85 ? #ef4444 : #10b981;
                    }
                }

                // Storage Section (Supports Multi-Disk List or Primary View)
                if root.enable_disks : MetricSection {
                    title: root.i18n_disks_title;
                    icon_source: @image-url("../assets/icons/disk.svg");
                    accent_color: #f59e0b;
                    badge: root.disk_primary_name;

                    if !root.show_all_disks : VerticalLayout {
                        spacing: 5px;
                        ProgressBar {
                            progress: root.disk_primary_percent;
                            bar_color: root.disk_primary_percent > 0.90 ? #ef4444 : #f59e0b;
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: root.disk_primary_usage;
                                font-size: 10px;
                                color: #cbd5e1;
                                overflow: elide;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "↓ R: " + root.disk_read_str;
                                font-size: 10px;
                                color: #34d399;
                                overflow: elide;
                            }
                            Text {
                                text: "↑ W: " + root.disk_write_str;
                                font-size: 10px;
                                color: #f87171;
                                overflow: elide;
                            }
                        }
                    }

                    if root.show_all_disks : VerticalLayout {
                        spacing: 6px;
                        for disk in root.disks_list : VerticalLayout {
                            spacing: 3px;
                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: disk.name != "" ? disk.mount + " " + disk.name : disk.mount;
                                    font-size: 9.5px;
                                    font-weight: 600;
                                    color: #f1f5f9;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: disk.used_gb + " / " + disk.total_gb;
                                    font-size: 9px;
                                    color: #94a3b8;
                                    overflow: elide;
                                }
                            }
                            ProgressBar {
                                progress: disk.percent;
                                bar_color: disk.percent > 0.90 ? #ef4444 : #f59e0b;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "↓ " + disk.read_speed;
                                    font-size: 9px;
                                    color: #34d399;
                                    overflow: elide;
                                }
                                Text {
                                    text: "↑ " + disk.write_speed;
                                    font-size: 9px;
                                    color: #f87171;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                // Network Section (Shows Local IP and External WAN IP)
                if root.enable_network : MetricSection {
                    title: root.i18n_network_title;
                    icon_source: @image-url("../assets/icons/network.svg");
                    accent_color: #f43f5e;
                    badge: root.net_download_str;

                    EditableLabel {
                        text: root.net_adapter_name;
                        font_size: 10px;
                        text_color: #94a3b8;
                        accent_color: #f43f5e;
                        committed(val) => { root.request_set_custom_net_name(val); }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "↓ " + root.net_download_str;
                            font-size: 11px;
                            font-weight: 600;
                            color: #38bdf8;
                            overflow: elide;
                        }
                        Text {
                            text: "↑ " + root.net_upload_str;
                            font-size: 11px;
                            font-weight: 600;
                            color: #fb7185;
                            overflow: elide;
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: root.sidebar_width_px < 220 ? root.net_ip_str : root.i18n_local_ip + ": " + root.net_ip_str;
                            font-size: 9px;
                            color: #64748b;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if root.sidebar_width_px >= 220 : Text {
                            text: root.i18n_wan_ip + ": " + root.net_ext_ip_str;
                            font-size: 9px;
                            color: #38bdf8;
                            overflow: elide;
                        }
                    }

                    if root.show_sparklines : Sparkline {
                        values: root.net_history;
                        line_color: #f43f5e;
                    }
                }
            }
        }

        // Bottom Footer Bar
        Rectangle {
            background: #14151edd;
            border-radius: 8px;
            border-width: 1px;
            border-color: #ffffff10;
            height: 32px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: space-between;

                HorizontalLayout {
                    alignment: center;
                    spacing: 5px;
                    horizontal-stretch: 1;
                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 13px;
                        height: 13px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 5px;
                        height: 5px;
                        border-radius: 2.5px;
                        background: #10b981;
                    }
                    Text {
                        text: root.i18n_hotkey_hint;
                        font-size: 8px;
                        color: #64748b;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;

                    // Close/Hide to tray button
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        background: touch_hide.has-hover ? #ef444430 : #ffffff0a;
                        border-radius: 4px;
                        animate background { duration: 120ms; }
                        Image {
                            source: @image-url("../assets/icons/close.svg");
                            width: 10px;
                            height: 10px;
                            colorize: touch_hide.has-hover ? #ef4444 : #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            animate colorize { duration: 120ms; }
                        }
                        touch_hide := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.request_quit(); }
                        }
                    }
                }
            }
        }
    }
}
