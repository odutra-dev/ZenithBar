import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { SettingsWindow } from "settingswindow.slint";
export { SettingsWindow }

export struct DiskInfo {
    name: string,
    mount: string,
    used_gb: string,
    total_gb: string,
    percent: float,
    read_speed: string,
    write_speed: string,
}

component Sparkline inherits Rectangle {
    in property <[float]> values: [0.1, 0.2, 0.15, 0.4, 0.6, 0.35, 0.5, 0.7, 0.65, 0.8];
    in property <color> line_color: #38bdf8;
    height: 36px;
    background: #00000030;
    border-radius: 6px;
    clip: true;

    HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        for val in root.values : Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            VerticalLayout {
                alignment: end;
                Rectangle {
                    height: max(3px, val * (root.height - 8px));
                    background: root.line_color;
                    border-radius: 1px;
                }
            }
        }
    }
}

component ProgressBar inherits Rectangle {
    in property <float> progress: 0.5; // 0.0 to 1.0
    in property <color> bar_color: #38bdf8;
    height: 6px;
    background: #ffffff15;
    border-radius: 3px;
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width * max(0.0, min(1.0, root.progress));
        height: parent.height;
        background: root.bar_color;
        border-radius: 3px;
    }
}

component MetricSection inherits Rectangle {
    in property <string> title: "SECTION";
    in property <string> icon: "⚡";
    in property <color> accent_color: #38bdf8;
    in property <bool> alert_active: false;
    in property <string> badge: "";
    callback toggle_collapse();

    background: root.alert_active ? #2a1015ee : #181920ee;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.alert_active ? #ef444480 : #ffffff12;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // Header
        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.icon;
                    font-size: 13px;
                    color: root.alert_active ? #ef4444 : root.accent_color;
                    vertical-alignment: center;
                }
                Text {
                    text: root.title;
                    font-size: 12px;
                    font-weight: 700;
                    color: root.alert_active ? #fca5a5 : #f1f5f9;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                }
            }

            if root.badge != "": Text {
                text: root.badge;
                font-size: 11px;
                color: root.alert_active ? #ef4444 : root.accent_color;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        // Slot for children
        @children
    }
}

export component AppWindow inherits Window {
    title: "ZenithBar";
    icon: @image-url("../assets/icon.png");
    width: root.sidebar_width_px * 1px;
    no-frame: true;
    background: Colors.rgb(15, 16, 21).with-alpha(root.bg_opacity_val);
    default-font-family: "Segoe UI Variable Display, Segoe UI, sans-serif";

    // Callbacks to Rust
    callback request_toggle_dock();
    callback request_toggle_mode();
    callback request_toggle_topmost();
    callback request_open_settings();
    callback request_next_disk();
    callback request_quit();

    // Dynamic sizing & opacity
    in-out property <float> sidebar_width_px: 300;
    in-out property <float> bg_opacity_val: 0.96;

    // System Header
    in-out property <string> hostname: "Meu PC";
    in-out property <string> time_str: "12:00:00";
    in-out property <string> date_str: "Sábado, 14 Nov";
    in-out property <string> uptime_str: "0h 0m";
    in-out property <string> mode_badge: "USER MODE";
    in-out property <bool> is_appbar: true;
    in-out property <bool> is_docked_right: true;

    // Telemetria modular e preferências visuais
    in-out property <bool> enable_cpu: true;
    in-out property <bool> show_cpu_cores: true;
    in-out property <bool> enable_ram: true;
    in-out property <bool> enable_gpu: true;
    in-out property <bool> enable_disks: true;
    in-out property <bool> enable_network: true;
    in-out property <bool> show_sparklines: true;
    in-out property <bool> show_machine_name: true;
    in-out property <bool> show_clock: true;
    in-out property <bool> collapse_menu_bar: false;

    // CPU
    in-out property <string> cpu_name: "Intel / AMD Processor";
    in-out property <float> cpu_usage: 0.15;
    in-out property <string> cpu_usage_str: "15%";
    in-out property <string> cpu_clock_str: "4.20 GHz";
    in-out property <string> cpu_temp_str: "45 °C";
    in-out property <float> cpu_temp_val: 45.0;
    in-out property <[float]> cpu_history: [0.1, 0.12, 0.15, 0.14, 0.18, 0.22, 0.19, 0.16, 0.15, 0.15];
    in-out property <[float]> cpu_core_loads: [0.1, 0.2, 0.15, 0.25, 0.1, 0.3, 0.05, 0.18];

    // RAM
    in-out property <string> ram_usage_str: "8.2 / 32.0 GB";
    in-out property <float> ram_percent: 0.25;
    in-out property <string> ram_percent_str: "25%";
    in-out property <string> ram_available_str: "23.8 GB Disp.";
    in-out property <[float]> ram_history: [0.25, 0.25, 0.25, 0.26, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25];

    // GPU
    in-out property <bool> gpu_detected: true;
    in-out property <string> gpu_name: "GPU Dedicada";
    in-out property <float> gpu_usage: 0.20;
    in-out property <string> gpu_usage_str: "20%";
    in-out property <string> gpu_temp_str: "52 °C";
    in-out property <float> gpu_temp_val: 52.0;
    in-out property <string> gpu_vram_str: "3.5 / 12.0 GB";
    in-out property <string> gpu_fan_str: "1250 RPM";
    in-out property <[float]> gpu_history: [0.05, 0.08, 0.12, 0.25, 0.32, 0.20, 0.15, 0.18, 0.22, 0.20];

    // Disks
    in-out property <bool> show_all_disks: false;
    in-out property <[DiskInfo]> disks_list: [];
    in-out property <string> disk_primary_name: "C: (SSD)";
    in-out property <string> disk_primary_usage: "450 / 950 GB (47%)";
    in-out property <float> disk_primary_percent: 0.47;
    in-out property <string> disk_read_str: "0.0 MB/s";
    in-out property <string> disk_write_str: "1.2 MB/s";

    // Network
    in-out property <string> net_adapter_name: "Ethernet / Wi-Fi";
    in-out property <string> net_download_str: "12.4 Mbps";
    in-out property <string> net_upload_str: "2.1 Mbps";
    in-out property <string> net_ip_str: "192.168.1.100";
    in-out property <string> net_ext_ip_str: "--";
    in-out property <[float]> net_history: [0.1, 0.15, 0.3, 0.8, 0.5, 0.2, 0.1, 0.4, 0.6, 0.25];

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // Top System Bar
        Rectangle {
            background: #14151edd;
            border-radius: 8px;
            border-width: 1px;
            border-color: #ffffff10;
            height: 72px;

            HorizontalLayout {
                padding: 10px;
                alignment: space-between;

                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;

                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 32px;
                        height: 32px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: root.time_str;
                                font-size: 19px;
                                font-weight: 800;
                                color: #ffffff;
                            }
                            Text {
                                text: root.hostname;
                                font-size: 11px;
                                font-weight: 600;
                                color: #38bdf8;
                                vertical-alignment: center;
                                overflow: elide;
                                visible: root.show_machine_name;
                            }
                        }

                        if root.show_clock : HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.date_str;
                                font-size: 10px;
                                color: #94a3b8;
                            }
                            Text {
                                text: "• " + root.uptime_str;
                                font-size: 10px;
                                color: #64748b;
                            }
                        }
                    }
                }

                if !root.collapse_menu_bar : HorizontalLayout {
                    alignment: center;
                    spacing: 4px;

                    // Settings gear button
                    Rectangle {
                        width: 24px;
                        height: 22px;
                        background: #ffffff10;
                        border-radius: 4px;
                        Text {
                            text: "⚙";
                            font-size: 12px;
                            color: #cbd5e1;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.request_open_settings(); }
                        }
                    }

                    // Dock side switch button
                    Rectangle {
                        width: 24px;
                        height: 22px;
                        background: #ffffff10;
                        border-radius: 4px;
                        Text {
                            text: root.is_docked_right ? "⇥" : "⇤";
                            font-size: 13px;
                            color: #cbd5e1;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.request_toggle_dock(); }
                        }
                    }
                }
            }
        }

        // Main Scrollable Area for Metrics
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 8px;

                // CPU Section with Per-Core Grid & Threshold Alert
                if root.enable_cpu : MetricSection {
                    title: "PROCESSADOR (CPU)";
                    icon: "🔲";
                    accent_color: #38bdf8;
                    alert_active: root.cpu_usage > 0.85 || root.cpu_temp_val > 80.0;
                    badge: root.cpu_usage_str;

                    Text {
                        text: root.cpu_name;
                        font-size: 10px;
                        color: #94a3b8;
                        overflow: elide;
                    }

                    ProgressBar {
                        progress: root.cpu_usage;
                        bar_color: root.cpu_usage > 0.85 ? #ef4444 : #38bdf8;
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Clock: " + root.cpu_clock_str;
                            font-size: 10px;
                            color: #cbd5e1;
                        }
                        Text {
                            text: "Temp: " + root.cpu_temp_str;
                            font-size: 10px;
                            font-weight: 700;
                            color: root.cpu_temp_val > 80.0 ? #ef4444 : #f1f5f9;
                        }
                    }

                    // Per-Core Load Micro-Bars Grid
                    if root.cpu_core_loads.length > 0 : VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Uso por Núcleo:";
                            font-size: 9px;
                            color: #64748b;
                        }
                        HorizontalLayout {
                            spacing: 3px;
                            for core_load in root.cpu_core_loads : Rectangle {
                                horizontal-stretch: 1;
                                height: 22px;
                                background: #ffffff0a;
                                border-radius: 2px;
                                clip: true;
                                VerticalLayout {
                                    alignment: end;
                                    Rectangle {
                                        height: max(2px, core_load * 22px);
                                        background: core_load > 0.85 ? #ef4444 : (core_load > 0.5 ? #f59e0b : #38bdf8);
                                        border-radius: 1px;
                                    }
                                }
                            }
                        }
                    }

                    if root.show_sparklines : Sparkline {
                        values: root.cpu_history;
                        line_color: root.cpu_usage > 0.85 ? #ef4444 : #38bdf8;
                    }
                }

                // RAM Section with Threshold Alert
                if root.enable_ram : MetricSection {
                    title: "MEMÓRIA (RAM)";
                    icon: "💾";
                    accent_color: #a855f7;
                    alert_active: root.ram_percent > 0.90;
                    badge: root.ram_percent_str;

                    ProgressBar {
                        progress: root.ram_percent;
                        bar_color: root.ram_percent > 0.90 ? #ef4444 : #a855f7;
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.ram_usage_str;
                            font-size: 10px;
                            color: #cbd5e1;
                        }
                        Text {
                            text: root.ram_available_str;
                            font-size: 10px;
                            color: #94a3b8;
                        }
                    }

                    if root.show_sparklines : Sparkline {
                        values: root.ram_history;
                        line_color: root.ram_percent > 0.90 ? #ef4444 : #a855f7;
                    }
                }

                // GPU Section with Threshold Alert
                if (root.gpu_detected && root.enable_gpu) : MetricSection {
                    title: "PLACA DE VÍDEO (GPU)";
                    icon: "🎮";
                    accent_color: #10b981;
                    alert_active: root.gpu_usage > 0.85 || root.gpu_temp_val > 80.0;
                    badge: root.gpu_usage_str;

                    Text {
                        text: root.gpu_name;
                        font-size: 10px;
                        color: #94a3b8;
                        overflow: elide;
                    }

                    ProgressBar {
                        progress: root.gpu_usage;
                        bar_color: root.gpu_usage > 0.85 ? #ef4444 : #10b981;
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "VRAM: " + root.gpu_vram_str;
                            font-size: 10px;
                            color: #cbd5e1;
                        }
                        Text {
                            text: "Temp: " + root.gpu_temp_str;
                            font-size: 10px;
                            font-weight: 700;
                            color: root.gpu_temp_val > 80.0 ? #ef4444 : #f1f5f9;
                        }
                    }

                    if root.gpu_fan_str != "" : Text {
                        text: "Fan: " + root.gpu_fan_str;
                        font-size: 10px;
                        color: #94a3b8;
                    }

                    if root.show_sparklines : Sparkline {
                        values: root.gpu_history;
                        line_color: root.gpu_usage > 0.85 ? #ef4444 : #10b981;
                    }
                }

                // Storage Section (Supports Multi-Disk List or Primary View)
                if root.enable_disks : MetricSection {
                    title: "ARMAZENAMENTO";
                    icon: "💽";
                    accent_color: #f59e0b;
                    badge: root.disk_primary_name;

                    if !root.show_all_disks : VerticalLayout {
                        spacing: 6px;
                        ProgressBar {
                            progress: root.disk_primary_percent;
                            bar_color: root.disk_primary_percent > 0.90 ? #ef4444 : #f59e0b;
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: root.disk_primary_usage;
                                font-size: 10px;
                                color: #cbd5e1;
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "↓ R: " + root.disk_read_str;
                                font-size: 10px;
                                color: #34d399;
                            }
                            Text {
                                text: "↑ W: " + root.disk_write_str;
                                font-size: 10px;
                                color: #f87171;
                            }
                        }
                    }

                    if root.show_all_disks : VerticalLayout {
                        spacing: 8px;
                        for disk in root.disks_list : VerticalLayout {
                            spacing: 3px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: disk.mount + " " + disk.name;
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: #f1f5f9;
                                }
                                Text {
                                    text: disk.used_gb + " / " + disk.total_gb;
                                    font-size: 9px;
                                    color: #94a3b8;
                                }
                            }
                            ProgressBar {
                                progress: disk.percent;
                                bar_color: disk.percent > 0.90 ? #ef4444 : #f59e0b;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "↓ " + disk.read_speed;
                                    font-size: 9px;
                                    color: #34d399;
                                }
                                Text {
                                    text: "↑ " + disk.write_speed;
                                    font-size: 9px;
                                    color: #f87171;
                                }
                            }
                        }
                    }
                }

                // Network Section (Shows Local IP and External WAN IP)
                if root.enable_network : MetricSection {
                    title: "REDE";
                    icon: "🌐";
                    accent_color: #f43f5e;
                    badge: root.net_download_str;

                    Text {
                        text: root.net_adapter_name;
                        font-size: 10px;
                        color: #94a3b8;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "↓ " + root.net_download_str;
                            font-size: 11px;
                            font-weight: 600;
                            color: #38bdf8;
                        }
                        Text {
                            text: "↑ " + root.net_upload_str;
                            font-size: 11px;
                            font-weight: 600;
                            color: #fb7185;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Local: " + root.net_ip_str;
                            font-size: 9px;
                            color: #64748b;
                        }
                        Text {
                            text: "WAN: " + root.net_ext_ip_str;
                            font-size: 9px;
                            color: #38bdf8;
                        }
                    }

                    if root.show_sparklines : Sparkline {
                        values: root.net_history;
                        line_color: #f43f5e;
                    }
                }
            }
        }

        // Bottom Footer Bar
        Rectangle {
            background: #14151edd;
            border-radius: 8px;
            border-width: 1px;
            border-color: #ffffff10;
            height: 36px;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: space-between;

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 14px;
                        height: 14px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: #10b981;
                    }
                    Text {
                        text: "ZenithBar • Hotkey: Ctrl+Shift+S";
                        font-size: 9px;
                        color: #64748b;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;

                    // Close/Quit
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        background: #ffffff0a;
                        border-radius: 4px;
                        Text {
                            text: "✕";
                            font-size: 11px;
                            color: #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.request_quit(); }
                        }
                    }
                }
            }
        }
    }
}
