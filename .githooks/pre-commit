#!/usr/bin/env bash
set -euo pipefail

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM)"
if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# 1. Check for merge conflict markers or UTF-8 mojibake in staged text/code files
while IFS= read -r file; do
    [ -f "$file" ] || continue
    case "$file" in
        *.rs|*.slint|*.json|*.toml|*.md|*.sh|*.yml|*.yaml|.githooks/*)
            if grep -nE '^(<<<<<<<|=======|>>>>>>>)' "$file" >/dev/null 2>&1; then
                echo "ERROR: Merge conflict markers found in staged file: $file" >&2
                exit 1
            fi
            if grep -n $'\xc3\x82\xc2\xb0' "$file" >/dev/null 2>&1; then
                echo "ERROR: UTF-8 mojibake (degree symbol encoding issue) found in staged file: $file" >&2
                exit 1
            fi
            ;;
    esac
done <<< "$STAGED_FILES"

# 2. Validate Rust & Slint compilation when Rust/Slint/Cargo files are staged
if echo "$STAGED_FILES" | grep -qE '\.(rs|slint)$|^Cargo\.(toml|lock)$'; then
    CARGO_BIN=""
    if command -v cargo >/dev/null 2>&1; then
        CARGO_BIN="$(command -v cargo)"
    elif [ -x "$HOME/.cargo/bin/cargo" ]; then
        CARGO_BIN="$HOME/.cargo/bin/cargo"
    fi

    if [ -n "$CARGO_BIN" ]; then
        echo "[pre-commit] Running cargo check..."
        "$CARGO_BIN" check --quiet
    else
        echo "[pre-commit] Warning: cargo not found in PATH, skipping cargo check." >&2
    fi
fi
